{
    "jwt": {
        "secret": "CHANGE_ME_generate_a_long_random_string",
        "expiresIn": "7d"
    },
    "oauth": {
        "google": {
            "clientId": "your-google-client-id",
            "clientSecret": "your-google-client-secret",
            "callbackUrl": "http://localhost:3001/api/auth/google/callback"
        },
        "facebook": {
            "appId": "your-facebook-app-id",
            "appSecret": "your-facebook-app-secret",
            "callbackUrl": "http://localhost:3001/api/auth/facebook/callback"
        }
    },
    "ebay": {
        "_comment": "Da https://developer.ebay.com/my/keys - app 'Production' per risultati reali, 'Sandbox' solo per test con dati finti",
        "clientId": "your-ebay-client-id",
        "clientSecret": "your-ebay-client-secret",
        "sandbox": false
    },
    "google": {
        "_comment": "Chiave server per la Google Weather API (Cloud Console: abilita 'Weather API', restringi per IP). In alternativa variabile d'ambiente GOOGLE_WEATHER_KEY.",
        "weatherKey": "your-google-weather-key"
    },
    "mail": {
        "smtp": {
            "host": "smtp.example.com",
            "port": 587,
            "secure": false,
            "user": "your-smtp-user",
            "pass": "your-smtp-password"
        },
        "from": "Fishlog <no-reply@fishlog.local>"
    },
    "features": {
        "_comment": "Metti passwordAuth a false in produzione finché l'SMTP non è configurato: disabilita registrazione, cambio password e cambio email (restano attivi login e OAuth)",
        "passwordAuth": true
    }
}
